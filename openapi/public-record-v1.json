{
  "openapi": "3.1.0",
  "info": {
    "title": "The Public Record — API contract baseline",
    "version": "0.1.0",
    "description": "Schemas for planned domain contracts. Only /api/health is currently implemented; other endpoints are not advertised as live."
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Report scaffold state without claiming readiness",
        "operationId": "getScaffoldHealth",
        "responses": {
          "200": {
            "description": "Service exists; production_ready remains false until production gates.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service",
          "status",
          "production_ready"
        ],
        "properties": {
          "service": {
            "type": "string",
            "const": "the-public-record"
          },
          "status": {
            "type": "string",
            "const": "scaffold"
          },
          "production_ready": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "ClaimStatus": {
        "type": "string",
        "enum": [
          "question_posed",
          "uncorroborated_assertion",
          "source_supported",
          "agency_stated",
          "document_confirmed",
          "disputed",
          "corrected"
        ]
      },
      "MissingRecordStatus": {
        "type": "string",
        "enum": [
          "referenced_by_source",
          "requested",
          "no_responsive_records",
          "withheld_stated_exemption",
          "referred",
          "expected_unverified",
          "released",
          "partial",
          "unresolved"
        ]
      },
      "RequestState": {
        "type": "string",
        "enum": [
          "unclaimed",
          "adopted",
          "draft",
          "submitted_unverified",
          "acknowledged",
          "in_process",
          "released",
          "partially_released",
          "denied",
          "appealed",
          "archived"
        ]
      },
      "DataClassification": {
        "type": "string",
        "enum": [
          "public_metadata",
          "private_draft",
          "private_correspondence",
          "quarantined_original",
          "reviewed_derivative",
          "public_derivative"
        ]
      },
      "PublicQuestion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "headline",
          "claim_status",
          "citation_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]{2,120}$"
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "claim_status": {
            "$ref": "#/components/schemas/ClaimStatus"
          },
          "citation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100
          }
        }
      },
      "ConsentItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "grant_id",
          "status",
          "scope"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "grant_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "granted",
              "revoked"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "web_publication",
              "distributed_replication"
            ]
          }
        }
      },
      "RequestEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "source",
          "evidence_id",
          "reviewer_verified"
        ],
        "properties": {
          "from": {
            "$ref": "#/components/schemas/RequestState"
          },
          "to": {
            "$ref": "#/components/schemas/RequestState"
          },
          "source": {
            "type": "string",
            "enum": [
              "requester_report",
              "verified_agency_document",
              "reviewed_publication"
            ]
          },
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewer_verified": {
            "type": "boolean"
          }
        }
      },
      "PageOptions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
